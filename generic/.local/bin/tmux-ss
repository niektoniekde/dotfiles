#!/usr/bin/env bash
set -euo pipefail

script_name="$(basename ${0})"
declare ch_nl=$'\n'
declare -A sessions
declare -a sessions_list=(
  "${HOME}/.local/etc/tmux-ss/local.list"
  "${HOME}/.local/etc/tmux-ss/personal.list"
  "${HOME}/.local/etc/tmux-ss/generic.list"
)
declare -i sessions_list_length="${#sessions_list[@]}"

__session_parse() {
  while read -r session
  do
    # skip comments
    if [[ ${session%%=*} =~ ^[#] ]]; then
      continue
    fi

    declare session_name="${session%%=*}"
    declare session_path="${session#*=}"

    [[ -d "${session_path}" ]] || continue
    [[ ${session_name} =~ ^[A-Za-z0-9_-]+$ ]] || continue

    sessions[$session_name]="${session_path}"

  done <<< ${1}
}

__call_tmux() {
  [[ -z ${1} ]] && exit

  if [[ ! ${1} =~ ^[A-Za-z0-9_-]+$ ]]
  then 
    echo "${script_name}: fzf returned invalid session_name: '${1}'"
    exit 70
  fi

  declare session_name="${1}"
  declare -i session_exists=1

  if $(tmux has-session -t "${1}" 2>/dev/null)
  then session_exists=0
  fi

  if [[ ${session_exists} -eq 1 ]]
  then tmux new-session -d -c "${sessions[$session_name]}" -s "${1}"
  fi

  if [[ -n ${TMUX:-} ]] 
  then tmux switch-client -t "${session_name}"
  else tmux attach -t "${session_name}"
  fi
}

__session_parse "$(
  tmux ls -F '#{session_name}=#{session_path}' 2>/dev/null || echo ""
  for ((i=0; i<${sessions_list_length}; i++))
  do
    cat "${sessions_list[$i]}" 2>/dev/null || echo ""
  done
)"

__call_tmux "$(
  declare sessions_live="$(
    tmux ls -F '#{session_name}' 2>/dev/null || echo ""
  )"

  declare -i max_length=0
  for key in "${!sessions[@]}"
  do
    (( ${#key} > max_length )) && max_length=${#key}
    max_length=$((max_length+1))
  done

  for key in "${!sessions[@]}"
  do
    declare -i key_length=${#key}
    declare -i align_length=$((max_length-key_length))
    aligment=$(printf '%*s' ${align_length} " ")
    is_live="-"
    is_live_regex="(^|${ch_nl})${key}($|${ch_nl})"
    [[ ${sessions_live} =~ $is_live_regex ]] && is_live="+"
    printf "%s\t%s\t%s%s\n" "${is_live}" "${key}" "${aligment}" "${sessions[$key]}"
  done | fzf -e --delimiter='\t' --tabstop=1 --accept-nth=2
)"

exit
